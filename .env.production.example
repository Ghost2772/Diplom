# Public domain without https:// or a trailing slash.
DOMAIN=demo.example.com
ACME_EMAIL=you@example.com

# Generate three DIFFERENT values with: openssl rand -hex 32
# Hex avoids URL-special characters in the PostgreSQL connection string.
SECRET_KEY=
POSTGRES_PASSWORD=
DEMO_ADMIN_PASSWORD=
DEMO_ADMIN_EMAIL=admin@mullers.local
POSTGRES_DB=weapon_store
POSTGRES_USER=weapon_store
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Isolated portfolio demo sessions and initial catalog.
DEMO_LOGIN_ENABLED=true
DEMO_SESSION_MINUTES=60
DEMO_MAX_SESSIONS=100
SEED_DEMO_DATA=true

# Optional GigaChat Authorization Key (Base64, without the Basic prefix).
# Configure the provider's usage quota before enabling public AI access.
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
# After downloading the official certificate into weapon-store-backend/certs:
# GIGACHAT_CA_BUNDLE=/app/certs/russian_trusted_root_ca_pem.crt
GIGACHAT_CA_BUNDLE=
