# Application
APP_ENV=development
DEBUG=false
SQL_ECHO=false
SECRET_KEY=replace-with-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# PostgreSQL
POSTGRES_DB=weapon_store
POSTGRES_USER=weapon_store
POSTGRES_PASSWORD=weapon_store
POSTGRES_PORT=5432

# Optional AI integration
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_VERIFY_SSL=true

# Demo data. Change these values before exposing the project publicly.
SEED_DEMO_DATA=true
DEMO_ADMIN_EMAIL=admin@mullers.local
DEMO_ADMIN_PASSWORD=ChangeMe123!
